@{
    var title = ViewData["Title"] as string ?? "FieldTech";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · FieldTech</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --bg: #0b1220;
            --card: rgba(255,255,255,.06);
            --card2: rgba(255,255,255,.08);
            --stroke: rgba(255,255,255,.10);
            --text: rgba(255,255,255,.92);
            --muted: rgba(255,255,255,.62);
            --brand: #7c3aed;
            --brand2: #22c55e;
            --warn: #f59e0b;
            --danger: #ef4444;
        }

        body {
            background: radial-gradient(1200px 600px at 20% -10%, rgba(124,58,237,.35), transparent 60%), radial-gradient(900px 500px at 90% 0%, rgba(34,197,94,.25), transparent 55%), linear-gradient(180deg, #070b14, var(--bg));
            color: var(--text);
            min-height: 100vh;
        }

        .glass {
            background: var(--card);
            border: 1px solid var(--stroke);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 18px;
            box-shadow: 0 16px 40px rgba(0,0,0,.35);
        }

        .navbar {
            border-bottom: 1px solid var(--stroke);
            background: rgba(7,11,20,.65) !important;
            backdrop-filter: blur(12px);
        }

        .brand-badge {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(124,58,237,.9), rgba(34,197,94,.85));
            box-shadow: 0 10px 25px rgba(124,58,237,.25);
        }

        .nav-link {
            color: rgba(255,255,255,.78) !important;
            border-radius: 12px;
            padding: .55rem .85rem !important;
        }

            .nav-link:hover {
                background: rgba(255,255,255,.06);
                color: #fff !important;
            }

            .nav-link.active {
                background: rgba(124,58,237,.22);
                border: 1px solid rgba(124,58,237,.35);
                color: #fff !important;
            }

        .chip {
            padding: .35rem .6rem;
            border-radius: 999px;
            background: rgba(255,255,255,.06);
            border: 1px solid var(--stroke);
            color: var(--muted);
            font-size: .85rem;
        }

        .page-wrap {
            max-width: 1180px;
        }

        .muted {
            color: var(--muted);
        }

        .kpi {
            padding: 16px;
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.04));
            border: 1px solid var(--stroke);
        }

            .kpi .value {
                font-size: 1.8rem;
                font-weight: 800;
                letter-spacing: .2px;
            }

            .kpi .label {
                color: var(--muted);
                font-size: .9rem;
            }

        .btn-brand {
            background: linear-gradient(135deg, rgba(124,58,237,.95), rgba(124,58,237,.65));
            border: 1px solid rgba(124,58,237,.4);
            color: #fff;
        }

            .btn-brand:hover {
                filter: brightness(1.08);
                color: #fff;
            }

        .btn-ghost {
            background: rgba(255,255,255,.06);
            border: 1px solid var(--stroke);
            color: #fff;
        }

            .btn-ghost:hover {
                background: rgba(255,255,255,.09);
                color: #fff;
            }

        .table {
            --bs-table-color: rgba(255,255,255,.9);
            --bs-table-bg: transparent;
            --bs-table-border-color: rgba(255,255,255,.08);
        }

            .table thead th {
                color: rgba(255,255,255,.7);
                font-weight: 700;
            }

        .status {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .25rem .6rem;
            border-radius: 999px;
            border: 1px solid var(--stroke);
            background: rgba(255,255,255,.05);
            font-size: .85rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .dot-green {
            background: var(--brand2);
            box-shadow: 0 0 0 3px rgba(34,197,94,.15);
        }

        .dot-warn {
            background: var(--warn);
            box-shadow: 0 0 0 3px rgba(245,158,11,.18);
        }

        .dot-red {
            background: var(--danger);
            box-shadow: 0 0 0 3px rgba(239,68,68,.16);
        }

        .card-title {
            letter-spacing: .2px;
        }

        .footer-note {
            color: rgba(255,255,255,.45);
            font-size: .85rem;
        }

        /* Auth pages center */
        .auth-shell {
            min-height: calc(100vh - 74px);
            display: grid;
            place-items: center;
            padding: 32px 12px;
        }

        .auth-card {
            max-width: 520px;
            width: 100%;
        }

        .form-control, .form-select {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            color: #fff;
            border-radius: 14px;
        }

            .form-control:focus, .form-select:focus {
                background: rgba(255,255,255,.08);
                border-color: rgba(124,58,237,.55);
                box-shadow: 0 0 0 .2rem rgba(124,58,237,.18);
                color: #fff;
            }

            .form-control::placeholder {
                color: rgba(255,255,255,.45);
            }

        label {
            color: rgba(255,255,255,.75);
        }

        a {
            text-decoration: none;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container page-wrap py-2">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/Home/Dashboard">
                <span class="brand-badge"><i class="bi bi-tools"></i></span>
                <div class="d-flex flex-column lh-sm">
                    <span class="fw-bold">FieldTech</span>
                    <small class="muted">Órdenes & ruta</small>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav me-auto gap-1 mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Marketplace"><i class="bi bi-shop me-1"></i>Marketplace</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Profile"><i class="bi bi-person-circle me-1"></i>Mi perfil</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <span class="chip d-none d-lg-inline"><i class="bi bi-geo-alt me-1"></i>Zona: Central</span>
                    <a class="btn btn-ghost btn-sm px-3" href="/Home/Login">
                        <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container page-wrap py-4">
        @RenderBody()

        <div class="mt-4 footer-note">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <span>© @DateTime.Now.Year · FieldTech</span>
                <span>Hecho para técnico de campo · UI demo</span>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
