@{
    ViewData["Title"] = "Login";
   
}

<div class="auth-shell">
    <div class="glass p-3 p-md-4 auth-card">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="brand-badge"><i class="bi bi-box-arrow-in-right"></i></span>
            <div>
                <div class="fw-bold fs-4">Iniciar sesión</div>
                <div class="muted">Accede como Técnico o como Empresa/Persona.</div>
            </div>
        </div>

        <hr style="border-color: rgba(255,255,255,.12);" />

        <form>
            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input type="email" class="form-control" placeholder="tu@correo.com" />
            </div>

            <div class="mb-2">
                <label class="form-label">Contraseña</label>
                <input type="password" class="form-control" placeholder="••••••••" />
            </div>

            <div class="d-flex justify-content-between align-items-center my-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="remember" />
                    <label class="form-check-label muted" for="remember">Recordarme</label>
                </div>
                <a class="muted" href="#">¿Olvidaste tu contraseña?</a>
            </div>

            <div class="d-grid gap-2">
         
                <a class="btn btn-brand btn-lg" href="/Home/Dashboard">
                    <i class="bi bi-lightning-charge me-1"></i>Entrar
                </a>

                <a class="btn btn-ghost" href="/Home/Register">
                    Crear cuenta
                </a>
            </div>

            <div class="mt-3 muted" style="font-size:.9rem;">
                Tip: en el backend luego validás el rol y redirigís:
                Técnico → Dashboard de órdenes / Empresa → Marketplace (publicar solicitudes)
            </div>
        </form>
    </div>
</div>
