@model FieldTechWeb.Models.DetalleOrdenViewModel
@{
    ViewData["Title"] = "OT-" + Model.Orden.WorkOrderId;
    var o            = Model.Orden;
    var tipoUsuario  = Context.Session.GetString("TipoUsuario");
    var userId       = Context.Session.GetInt32("UserId");
    var dotS         = o.Status == "OPEN" ? "dot-green" : o.Status == "IN_PROGRESS" ? "dot-warn" : o.Status == "COMPLETED" ? "dot-muted" : "dot-red";
    var dotU         = o.Urgency == "HIGH" ? "dot-red" : o.Urgency == "NORMAL" ? "dot-warn" : "dot-muted";
    var miAsignacion = Model.Asignaciones.FirstOrDefault(a => a.TechnicianUserId == userId);
    var checkInAbierto = Model.CheckIns.FirstOrDefault(c => c.CheckOutAt == null);
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <a class="btn btn-ghost btn-sm" onclick="history.back()"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
        <h2 class="mb-0 fw-bold">OT-@o.WorkOrderId — @o.Title</h2>
        <div class="muted">@(o.ClientDisplayName ?? o.ClientName) · @o.LocationText</div>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
        <span class="status"><span class="dot @dotS"></span>@o.Status</span>
        <span class="status"><span class="dot @dotU"></span>@o.Urgency</span>
    </div>
</div>

<div class="row g-3">

    <!-- ── COLUMNA IZQUIERDA ──────────────────────────── -->
    <div class="col-12 col-lg-8">

        <!-- Detalles -->
        <div class="glass p-3 p-md-4 mb-3">
            <h5 class="fw-bold mb-3 card-title">Detalles de la orden</h5>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="muted" style="font-size:.82rem;">Categoría</div>
                    <div>@(o.Category ?? "—")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="muted" style="font-size:.82rem;">Presupuesto</div>
                    <div class="fw-bold">₡@o.BudgetAmount?.ToString("N0")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="muted" style="font-size:.82rem;">Contacto</div>
                    <div>@o.ClientPhone</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="muted" style="font-size:.82rem;">Creada</div>
                    <div>@o.CreatedAt?.ToString("dd MMM yyyy")</div>
                </div>
                @if (!string.IsNullOrEmpty(o.Description))
                {
                    <div class="col-12">
                        <div class="muted" style="font-size:.82rem;">Descripción</div>
                        <div>@o.Description</div>
                    </div>
                }
            </div>
        </div>

        <!-- Mensajes -->
        <div class="glass p-3 p-md-4 mb-3">
            <h5 class="fw-bold mb-3 card-title"><i class="bi bi-chat-dots me-2"></i>Mensajes</h5>
            <div class="d-flex flex-column gap-2 mb-3" style="max-height:320px;overflow-y:auto;" id="msgList">
                @if (!Model.Mensajes.Any())
                {
                    <div class="muted text-center py-3" style="font-size:.9rem;">Sin mensajes aún.</div>
                }
                @foreach (var m in Model.Mensajes)
                {
                    var esYo = m.SenderUserId == userId;
                    <div class="d-flex @(esYo ? "justify-content-end" : "")">
                        <div class="msg-bubble @(esYo ? "msg-yo" : "msg-otro")">
                            <div class="muted mb-1" style="font-size:.76rem;">
                                @m.SenderName · @m.CreatedAt?.ToString("HH:mm dd/MM")
                            </div>
                            <div>@m.Body</div>
                        </div>
                    </div>
                }
            </div>
            <form method="post" asp-controller="Orden" asp-action="EnviarMensaje"
                  asp-route-ordenId="@o.WorkOrderId" class="d-flex gap-2">
                <input name="cuerpo" class="form-control" placeholder="Escribe un mensaje..." required />
                <button type="submit" class="btn btn-brand px-3">
                    <i class="bi bi-send"></i>
                </button>
            </form>
        </div>

        <!-- Check-ins -->
        <div class="glass p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 card-title"><i class="bi bi-geo-alt me-2"></i>Check-ins</h5>

                @if (o.Status == "IN_PROGRESS")
                {
                    if (checkInAbierto == null)
                    {
                        <form method="post" asp-controller="Orden" asp-action="CheckIn"
                              asp-route-ordenId="@o.WorkOrderId">
                            <button type="submit" class="btn btn-brand btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Check-in
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-controller="Orden" asp-action="CheckOut">
                            <input type="hidden" name="ordenId"    value="@o.WorkOrderId" />
                            <input type="hidden" name="checkInId"  value="@checkInAbierto.CheckInId" />
                            <button type="submit" class="btn btn-ghost btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Check-out
                            </button>
                        </form>
                    }
                }
            </div>

            @if (!Model.CheckIns.Any())
            {
                <div class="muted text-center py-3" style="font-size:.9rem;">Sin registros de check-in.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Técnico</th>
                                <th>Entrada</th>
                                <th>Salida</th>
                                <th>Duración</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.CheckIns)
                            {
                                <tr>
                                    <td>@c.TechnicianName</td>
                                    <td>@c.CheckInAt?.ToString("HH:mm dd/MM")</td>
                                    <td>
                                        @if (c.CheckOutAt.HasValue)
                                        { @c.CheckOutAt.Value.ToString("HH:mm dd/MM") }
                                        else
                                        { <span class="status"><span class="dot dot-green"></span>Activo</span> }
                                    </td>
                                    <td>@(c.DurationMinutes.HasValue ? c.DurationMinutes + " min" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <!-- ── COLUMNA DERECHA ────────────────────────────── -->
    <div class="col-12 col-lg-4">

        <!-- Acciones según rol -->
        <div class="glass p-3 p-md-4 mb-3">
            <h5 class="fw-bold mb-3 card-title">Acciones</h5>
            <div class="d-grid gap-2">

                @if (tipoUsuario == "CLIENT" && o.Status == "OPEN")
                {
                    <form method="post" asp-controller="Orden" asp-action="CancelarOrden"
                          asp-route-id="@o.WorkOrderId"
                          onsubmit="return confirm('¿Cancelar esta orden?')">
                        <button type="submit" class="btn btn-danger-ghost w-100">
                            <i class="bi bi-x-circle me-1"></i>Cancelar orden
                        </button>
                    </form>
                }

                @if (tipoUsuario == "TECH")
                {
                    @if (miAsignacion == null && o.Status == "OPEN")
                    {
                        <p class="muted text-center mb-0" style="font-size:.9rem;">
                            Escríbele al cliente para que te asigne a esta orden.
                        </p>
                    }
                    else if (miAsignacion?.Status == "PENDING")
                    {
                        <form method="post" asp-controller="Orden" asp-action="ResponderAsignacion">
                            <input type="hidden" name="asignacionId" value="@miAsignacion.AssignmentId" />
                            <input type="hidden" name="ordenId"      value="@o.WorkOrderId" />
                            <input type="hidden" name="aceptar"      value="true" />
                            <button type="submit" class="btn btn-brand w-100 mb-2">
                                <i class="bi bi-check2-circle me-1"></i>Aceptar asignación
                            </button>
                        </form>
                        <form method="post" asp-controller="Orden" asp-action="ResponderAsignacion">
                            <input type="hidden" name="asignacionId" value="@miAsignacion.AssignmentId" />
                            <input type="hidden" name="ordenId"      value="@o.WorkOrderId" />
                            <input type="hidden" name="aceptar"      value="false" />
                            <button type="submit" class="btn btn-danger-ghost w-100">
                                <i class="bi bi-x-circle me-1"></i>Rechazar
                            </button>
                        </form>
                    }
                    else if (miAsignacion?.Status == "ACCEPTED")
                    {
                        <form method="post" asp-controller="Orden" asp-action="CompletarAsignacion"
                              onsubmit="return confirm('¿Marcar como completada?')">
                            <input type="hidden" name="asignacionId" value="@miAsignacion.AssignmentId" />
                            <input type="hidden" name="ordenId"      value="@o.WorkOrderId" />
                            <button type="submit" class="btn btn-brand w-100">
                                <i class="bi bi-flag-fill me-1"></i>Marcar como completada
                            </button>
                        </form>
                    }
                }
            </div>
        </div>

        <!-- Asignaciones -->
        <div class="glass p-3 p-md-4">
            <h5 class="fw-bold mb-3 card-title"><i class="bi bi-person-badge me-2"></i>Técnicos asignados</h5>

            @if (!Model.Asignaciones.Any())
            {
                <div class="muted text-center py-3" style="font-size:.9rem;">Sin asignaciones aún.</div>
            }
            else
            {
                @foreach (var a in Model.Asignaciones)
                {
                    var adot = a.Status == "ACCEPTED" ? "dot-green" : a.Status == "PENDING" ? "dot-warn" : a.Status == "COMPLETED" ? "dot-muted" : "dot-red";
                    <div class="p-2 rounded-3 mb-2" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="fw-semibold">@a.TechnicianName</div>
                            <span class="status"><span class="dot @adot"></span>@a.Status</span>
                        </div>
                        <div class="muted mt-1" style="font-size:.82rem;">
                            Zona: @a.Zone · ₡@a.HourlyRate?.ToString("N0")/h
                            @if (a.AgreedAmount.HasValue)
                            { <span>· Acordado: ₡@a.AgreedAmount.Value.ToString("N0")</span> }
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        var ml = document.getElementById('msgList');
        if (ml) ml.scrollTop = ml.scrollHeight;
    </script>
}
