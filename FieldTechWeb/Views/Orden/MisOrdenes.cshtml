@model List<FieldTechWeb.Models.Orden>
@{
    ViewData["Title"] = "Mis órdenes";
    ViewData["Active"] = "MisOrdenes";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Mis órdenes de trabajo</h2>
        <div class="muted">Todas las órdenes que has publicado.</div>
    </div>
    <a class="btn btn-brand px-3" asp-controller="Orden" asp-action="CrearOrden">
        <i class="bi bi-plus-circle me-1"></i>Nueva orden
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass p-5 text-center muted">
        <i class="bi bi-clipboard-x fs-1 d-block mb-2"></i>
        No has publicado ninguna orden aún.
        <a asp-controller="Orden" asp-action="CrearOrden" class="d-block mt-2">Crea tu primera orden</a>
    </div>
}
else
{
    <div class="glass p-3 p-md-4">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Categoría</th>
                        <th>Ubicación</th>
                        <th>Presupuesto</th>
                        <th>Urgencia</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var dotU = o.Urgency == "HIGH" ? "dot-red" : o.Urgency == "NORMAL" ? "dot-warn" : "dot-muted";
                        var dotS = o.Status == "OPEN" ? "dot-green" : o.Status == "IN_PROGRESS" ? "dot-warn" : o.Status == "COMPLETED" ? "dot-muted" : "dot-red";
                        <tr>
                            <td class="fw-bold muted">OT-@o.WorkOrderId</td>
                            <td>@o.Title</td>
                            <td><span class="chip">@o.Category</span></td>
                            <td class="muted">@o.LocationText</td>
                            <td>₡@o.BudgetAmount?.ToString("N0")</td>
                            <td><span class="status"><span class="dot @dotU"></span>@o.Urgency</span></td>
                            <td><span class="status"><span class="dot @dotS"></span>@o.Status</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-ghost" asp-controller="Orden" asp-action="Detalle" asp-route-id="@o.WorkOrderId">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (o.Status == "OPEN")
                                {
                                    <form method="post" asp-controller="Orden" asp-action="CancelarOrden"
                                          asp-route-id="@o.WorkOrderId" class="d-inline"
                                          onsubmit="return confirm('¿Cancelar esta orden?')">
                                        <button type="submit" class="btn btn-sm btn-danger-ghost ms-1">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
