@{
    ViewData["Title"] = "Mi perfil";
    ViewData["Active"] = "Perfil";
    var nombre      = Context.Session.GetString("NombreUsuario");
    var tipoUsuario = Context.Session.GetString("TipoUsuario");
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Mi perfil</h2>
        <div class="muted">
            @(tipoUsuario == "TECH"
                ? "Configura tu disponibilidad, habilidades y tarifas como técnico freelance."
                : "Información de tu cuenta como cliente.")
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Tarjeta lateral -->
    <div class="col-12 col-lg-4">
        <div class="glass p-3 p-md-4">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-badge" style="width:56px;height:56px;border-radius:18px;">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">@nombre</div>
                    <div class="muted">@(tipoUsuario == "TECH" ? "Técnico Freelance" : "Cliente / Empresa")</div>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,.12);" />
            <div class="d-grid gap-2 mt-3">
                <a class="btn btn-ghost" asp-controller="Seguridad" asp-action="CambiarContrasenna">
                    <i class="bi bi-lock me-1"></i>Cambiar contraseña
                </a>
                <a class="btn btn-ghost" asp-controller="Home" asp-action="CerrarSesion">
                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                </a>
            </div>
        </div>
    </div>

    <!-- Info -->
    <div class="col-12 col-lg-8">
        <div class="glass p-3 p-md-4">
            <h4 class="fw-bold mb-1">Información de cuenta</h4>
            <div class="muted mb-3">Datos con los que iniciaste sesión.</div>
            <div class="row g-3">
                <div class="col-12">
                    <div class="muted" style="font-size:.85rem;">Nombre completo</div>
                    <div class="fw-semibold">@nombre</div>
                </div>
                <div class="col-12">
                    <div class="muted" style="font-size:.85rem;">Tipo de cuenta</div>
                    <div>
                        @if (tipoUsuario == "TECH")
                        {
                            <span class="chip"><i class="bi bi-tools me-1"></i>Técnico Freelance</span>
                        }
                        else
                        {
                            <span class="chip"><i class="bi bi-building me-1"></i>Cliente / Empresa</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
