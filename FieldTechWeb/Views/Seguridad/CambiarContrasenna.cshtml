@model FieldTechWeb.Models.CambiarContrasennaViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a class="btn btn-ghost btn-sm" asp-controller="Seguridad" asp-action="Perfil">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="mb-0 fw-bold">Cambiar contraseña</h2>
        <div class="muted">Una vez cambiada deberás iniciar sesión nuevamente.</div>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger rounded-3 mb-3 py-2">@ViewBag.Mensaje</div>
}

<div class="glass p-3 p-md-4" style="max-width:480px;">
    <form id="formCambiarContrasenna" method="post"
          asp-controller="Seguridad" asp-action="CambiarContrasenna">
        <div class="mb-3">
            <label class="form-label">Nueva contraseña</label>
            <input asp-for="NuevaContrasenna" type="password" class="form-control"
                   placeholder="Mínimo 8 caracteres" />
            <span asp-validation-for="NuevaContrasenna"
                  class="text-danger" style="font-size:.82rem;"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Confirmar contraseña</label>
            <input asp-for="ConfirmarContrasenna" type="password" class="form-control"
                   placeholder="Repite la contraseña" />
            <span asp-validation-for="ConfirmarContrasenna"
                  class="text-danger" style="font-size:.82rem;"></span>
        </div>
        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-ghost" asp-controller="Seguridad" asp-action="Perfil">Cancelar</a>
            <button type="submit" class="btn btn-brand ms-auto px-4">
                <i class="bi bi-check2-circle me-1"></i>Guardar
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/CambiarContrasenna.js" asp-append-version="true"></script>
}
