@model FieldTechWeb.Models.RecuperarAccesoViewModel
@{
    ViewData["Title"] = "Recuperar acceso";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="auth-shell">
    <div class="glass p-3 p-md-4 auth-card">

        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="brand-badge"><i class="bi bi-lock-fill"></i></span>
            <div>
                <div class="fw-bold fs-4">Recuperar acceso</div>
                <div class="muted">Te enviaremos una contraseña temporal por correo.</div>
            </div>
        </div>

        <hr style="border-color: rgba(255,255,255,.12);" />

        @if (ViewBag.Exito != null)
        {
            <div class="alert alert-success rounded-3 mb-3 py-2">
                <i class="bi bi-check2-circle me-2"></i>@ViewBag.Exito
            </div>
        }

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger rounded-3 mb-3 py-2">@ViewBag.Mensaje</div>
        }

        <form id="formRecuperar" method="post" asp-controller="Home" asp-action="RecuperarAcceso">
            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input asp-for="Email" type="email" class="form-control"
                       placeholder="correo@dominio.com" required />
            </div>

            <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-brand btn-lg">
                    <i class="bi bi-send me-1"></i>Enviar contraseña temporal
                </button>
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Login">
                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script src="~/js/RecuperarAcceso.js" asp-append-version="true"></script>
}
