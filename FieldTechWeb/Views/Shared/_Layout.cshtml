@{
    var title = ViewData["Title"] as string ?? "FieldTech";
    var nombre = Context.Session.GetString("NombreUsuario");
    var tipoUsuario = Context.Session.GetString("TipoUsuario");
    var estaLogueado = !string.IsNullOrEmpty(nombre);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — FieldTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container page-wrap py-2">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Orden" asp-action="Dashboard">
                <span class="brand-badge"><i class="bi bi-tools"></i></span>
                <div class="d-flex flex-column lh-sm">
                    <span class="fw-bold">FieldTech</span>
                    <small class="muted" style="font-size:.72rem;">Órdenes & ruta</small>
                </div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="topNav">
                @if (estaLogueado)
                {
                    <ul class="navbar-nav me-auto gap-1 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["Active"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Orden" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        @if (tipoUsuario == "TECH")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Active"]?.ToString() == "Marketplace" ? "active" : "")"
                                   asp-controller="Orden" asp-action="Marketplace">
                                    <i class="bi bi-shop me-1"></i>Marketplace
                                </a>
                            </li>
                        }
                        @if (tipoUsuario == "CLIENT")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Active"]?.ToString() == "MisOrdenes" ? "active" : "")"
                                   asp-controller="Orden" asp-action="MisOrdenes">
                                    <i class="bi bi-clipboard-list me-1"></i>Mis órdenes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Active"]?.ToString() == "CrearOrden" ? "active" : "")"
                                   asp-controller="Orden" asp-action="CrearOrden">
                                    <i class="bi bi-plus-circle me-1"></i>Nueva orden
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["Active"]?.ToString() == "Perfil" ? "active" : "")"
                               asp-controller="Seguridad" asp-action="Perfil">
                                <i class="bi bi-person-circle me-1"></i>Mi perfil
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span class="chip d-none d-lg-inline">
                            <i class="bi bi-person me-1"></i>@nombre
                        </span>
                        <a class="btn btn-ghost btn-sm px-3" asp-controller="Home" asp-action="CerrarSesion">
                            <i class="bi bi-box-arrow-right me-1"></i>Salir
                        </a>
                    </div>
                }
                else
                {
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">Acerca</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-ghost btn-sm" asp-controller="Home" asp-action="Login">Iniciar sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-brand btn-sm" asp-controller="Home" asp-action="Registro">Crear cuenta</a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container page-wrap py-4">
        @RenderBody()
        <div class="mt-4 footer-note">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <span>&copy; @DateTime.Now.Year FieldTech</span>
                <span>Plataforma de técnicos freelance</span>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
